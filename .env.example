# Mesh API Configuration
MESH_API_KEY=rsk_replace_me
MESH_BASE_URL=https://api.meshapi.ai/v1

# AI Models
PLANNER_MODEL=openai/gpt-4o-mini
DRAFTER_MODEL=openai/gpt-4o-mini
VERIFIER_MODEL=openai/gpt-4o-mini
CHEAP_MODEL=openai/gpt-4o-mini
SYNTHESIZER_MODEL=openai/gpt-4o

# Research Configuration
MAX_LOOPS=2
MIN_VERIFIED_CLAIMS=2
MIN_DISTINCT_DOMAINS=2
MAX_SOURCES_PER_SUBQ=6
MAX_CHUNKS_PER_SOURCE=4
CHUNK_CHARS=2000
CHUNK_OVERLAP=200
FETCH_TIMEOUT=15.0

# Drafting and Verification
DRAFTER_MAX_CHUNKS=12
MAX_CLAIMS_PER_SUBQ=6
MIN_QUOTE_COVERAGE=0.7
MIN_SENTENCE_COVERAGE=0.85
VERIFIER_WORKERS=2

# Run Limits
MAX_CONCURRENT_RUNS=2
MAX_RUNS_PER_HOUR=10

# Database
DB_PATH=data/deepdive.db

# Access Control
ACCESS_CODE=

# User Interface
SHOW_RECENT_RUNS=true